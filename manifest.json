{
  "manifest_version": 3,
  "name": "DSA Revision Tracker",
  "version": "1.0",
  "description": "Save DSA questions from any site to your Google Sheet and track revisions.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "action": { "default_popup": "popup.html", "default_title": "Save to DSA sheet" }
}
